{
  "openapi": "3.1.0",
  "info": {
    "title": "AquaLife C2 — HU1",
    "version": "0.1.0",
    "description": "P1: creación y lectura persistente. Autenticación Basic exclusiva de desarrollo local. Sin integración React ni JWT. HU1 E1/E2 del informe C1; enlace individual de Taiga pendiente de verificación."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Servidor local de desarrollo"
    }
  ],
  "security": [
    {
      "BasicLocal": []
    }
  ],
  "tags": [
    {
      "name": "Publicaciones",
      "description": "Crear y mostrar publicaciones (HU1). No incluye búsqueda HU3."
    }
  ],
  "paths": {
    "/api/v1/publicaciones": {
      "post": {
        "tags": [
          "Publicaciones"
        ],
        "operationId": "crearPublicacion",
        "summary": "Crear publicación (HU1-E1/E2)",
        "description": "Autor derivado de la cuenta activa autenticada. Solo contenido; rechaza campos adicionales. Recorta espacios exteriores y rechaza texto vacío, NUL o Unicode no codificable en UTF-8. Límite técnico del cuerpo: 1 MiB (manejo de Django fuera del contrato de errores funcionales).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contenido"
                ],
                "properties": {
                  "contenido": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "description": "Texto no vacío; no admite NUL ni Unicode inválido."
                  }
                }
              },
              "example": {
                "contenido": "¿Cómo cuidan sus acuarios?"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Publicación guardada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Publicacion"
                }
              }
            },
            "headers": {
              "Location": {
                "description": "Ruta del detalle creado",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o JSON malformado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Identidad ausente/inválida o contexto local no permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "406": {
            "description": "El cliente no admite JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Solo se admite JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Publicaciones"
        ],
        "operationId": "listarPublicaciones",
        "summary": "Mostrar publicaciones del foro como soporte de HU1",
        "description": "Orden creada_en DESC, id DESC. No admite tema ni otros parámetros adicionales. No implementa HU3.",
        "parameters": [
          {
            "name": "limite",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "desplazamiento",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de publicaciones; resultados puede estar vacío",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pagina"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o JSON malformado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Identidad ausente/inválida o contexto local no permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "406": {
            "description": "El cliente no admite JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/publicaciones/{id}": {
      "get": {
        "tags": [
          "Publicaciones"
        ],
        "operationId": "consultarPublicacion",
        "summary": "Consultar publicación persistida",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Publicación encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Publicacion"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o JSON malformado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Identidad ausente/inválida o contexto local no permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Publicación inexistente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Método no permitido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "406": {
            "description": "El cliente no admite JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BasicLocal": {
        "type": "http",
        "scheme": "basic",
        "description": "Solo cuentas activas, DJANGO_DEBUG=true y REMOTE_ADDR loopback. No disponible para producción ni clientes remotos."
      }
    },
    "schemas": {
      "Autor": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "nombre": {
            "type": "string"
          }
        }
      },
      "Publicacion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contenido",
          "creada_en",
          "autor"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "contenido": {
            "type": "string",
            "minLength": 1
          },
          "creada_en": {
            "type": "string",
            "format": "date-time"
          },
          "autor": {
            "$ref": "#/components/schemas/Autor"
          }
        }
      },
      "Pagina": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "total",
          "limite",
          "desplazamiento",
          "resultados"
        ],
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limite": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "desplazamiento": {
            "type": "integer",
            "minimum": 0
          },
          "resultados": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Publicacion"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "codigo",
              "detalles"
            ],
            "properties": {
              "codigo": {
                "type": "string"
              },
              "detalles": {
                "description": "Mapa de campos, objeto con detail o lista de errores de DRF.",
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": true
                  },
                  {
                    "type": "array",
                    "items": {}
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
